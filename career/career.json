        { "wins": 3, "boosters": 6, "reputation": 10 },
        { "wins": 2, "boosters": 3, "reputation": 6 },
        { "wins": 1, "boosters": 1, "reputation": 3 },
        { "wins": 0, "reputation": 1 }
