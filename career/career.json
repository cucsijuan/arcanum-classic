{
  // The career mode's store: prices in cents.
  "storeName": "Corner Cards & Games",
  "boosterPrice": 450,
  "preconPrice": 2000,
  "sellRate": 0.5,
  "values": { "common": 10, "uncommon": 25, "rare": 150, "mythic": 500, "special": 100, "bonus": 300 },

  "starter": {
    "cash": 1000,
    "boosters": 3,
    "decks": [
      "fdn-br", "fdn-gw", "fdn-rg", "fdn-ub", "fdn-wu",
      "m19-br", "m19-gw", "m19-rg", "m19-ub", "m19-wu",
      "ori-br", "ori-gw", "ori-rg", "ori-ub", "ori-wu",
      "hob-br", "hob-gw", "hob-rg", "hob-ub", "hob-wu",
      "m10-br", "m10-gw", "m10-rg", "m10-ub", "m10-wu"
    ]
  },

  "dailies": { "perDay": 2, "win": 450, "loss": 100, "winBoosters": 1 },

  // Practice against any regular you can meet: the first ones each day pay a little.
  "practice": { "paidPerDay": 3, "win": 50, "loss": 20 },

  // Ante matches: each player antes a card at random from their deck; the winner keeps both.
  "ante": { "perDay": 3 },

  // Reputation opens tougher regulars (each regular has a "tier").
  "tiers": [
    { "name": "Newcomer", "reputation": 0 },
    { "name": "Regular", "reputation": 30 },
    { "name": "Local favorite", "reputation": 100 },
    { "name": "Store champion", "reputation": 250 }
  ],

  // Each week three of these are drawn for the player. Kinds: winDaily, winMatch, winAnte, winCheap (value: the deck's
  // highest worth in cents), winMono, openBoosters, playPractice.
  // The regulars' daily offers at the store, and how fast rivals improve their decks.
  "offers": { "bargainRate": 0.6, "tradeSpread": 0.1, "rivalUpgrades": 2, "rivalWeeks": 12 },

  "challengesPerWeek": 3,
  "challenges": [
    { "id": "daily3", "text": "Win 3 daily matches", "kind": "winDaily", "count": 3, "boosters": 1 },
    { "id": "win5", "text": "Win 5 matches", "kind": "winMatch", "count": 5, "cash": 500 },
    { "id": "win10", "text": "Win 10 matches", "kind": "winMatch", "count": 10, "boosters": 2 },
    { "id": "ante1", "text": "Win an ante match", "kind": "winAnte", "count": 1, "cash": 300 },
    { "id": "ante3", "text": "Win 3 ante matches", "kind": "winAnte", "count": 3, "boosters": 1 },
    { "id": "budget", "text": "Win with a deck worth $15 or less", "kind": "winCheap", "value": 1500, "boosters": 1 },
    { "id": "mono", "text": "Win with a deck of a single color", "kind": "winMono", "boosters": 1 },
    { "id": "open5", "text": "Open 5 boosters", "kind": "openBoosters", "count": 5, "cash": 300 },
    { "id": "practice5", "text": "Play 5 practice matches", "kind": "playPractice", "count": 5, "cash": 200 }
  ],

  // Boosters on the shelf; the featured set changes every Monday (UTC) in this order.
  "sets": ["fdn", "m19", "ori", "hob", "ltr", "m10"],
  "featured": ["fdn", "hob", "m19", "ltr", "ori", "m10"],

  "precons": [
    { "deck": "fdn-br" }, { "deck": "fdn-gw" }, { "deck": "fdn-rg" }, { "deck": "fdn-ub" }, { "deck": "fdn-wu" },
    { "deck": "m19-br" }, { "deck": "m19-gw" }, { "deck": "m19-rg" }, { "deck": "m19-ub" }, { "deck": "m19-wu" },
    { "deck": "ori-br" }, { "deck": "ori-gw" }, { "deck": "ori-rg" }, { "deck": "ori-ub" }, { "deck": "ori-wu" },
    { "deck": "hob-br" }, { "deck": "hob-gw" }, { "deck": "hob-rg" }, { "deck": "hob-ub" }, { "deck": "hob-wu" },
    { "deck": "m10-br" }, { "deck": "m10-gw" }, { "deck": "m10-rg" }, { "deck": "m10-ub" }, { "deck": "m10-wu" }
  ],

  // The store's calendar (UTC days). "when": a weekday, or "lastSunday" (the last Sunday of the month). Prizes: the first
  // one that fits the player's result ("wins": at least that many match wins; "place": that place or better; neither:
  // anyone). Draft events take the week's featured set unless "set" names one; the drafted cards are the player's.
  "events": [
    {
      "id": "draft-night", "name": "Draft night", "when": "Wednesday", "kind": "draft", "set": "featured",
      "players": 8, "rounds": 3, "bestOf": 1, "entry": 1500, "entryBoosters": 3,
      "prizes": [
        { "wins": 3, "boosters": 6, "reputation": 10 },
        { "wins": 2, "boosters": 3, "reputation": 6 },
        { "wins": 1, "boosters": 1, "reputation": 3 },
        { "wins": 0, "reputation": 1 }
      ]
    },
    {
      "id": "saturday", "name": "Saturday tournament", "when": "Saturday", "kind": "constructed",
      "players": 8, "rounds": 3, "bestOf": 1, "entry": 2000,
      "prizes": [
        { "place": 1, "cash": 10000, "boosters": 4, "tokens": 1, "reputation": 15 },
        { "place": 2, "cash": 5000, "boosters": 2, "reputation": 10 },
        { "place": 4, "cash": 2000, "boosters": 1, "reputation": 6 },
        { "reputation": 2 }
      ]
    },
    {
      "id": "championship", "name": "Monthly championship", "when": "lastSunday", "kind": "constructed",
      "players": 16, "rounds": 4, "bestOf": 3, "entry": 5000, "entryTokens": 1, "minTier": 1,
      "prizes": [
        { "place": 1, "cash": 50000, "boosters": 10, "reputation": 40 },
        { "place": 2, "cash": 25000, "boosters": 6, "reputation": 25 },
        { "place": 4, "cash": 10000, "boosters": 3, "reputation": 15 },
        { "place": 8, "cash": 4000, "boosters": 1, "reputation": 8 },
        { "reputation": 4 }
      ]
    }
  ],

  // Visitors fill an event's seats after the regulars.
  "visitors": ["Alex Moreno", "Priya Nair", "Tomasz Wolski", "Grace Lin", "Diego Herrera", "Hana Sato", "Owen Clarke",
               "Fatima Diallo", "Lukas Becker", "Maya Cohen", "Rafael Souza", "Nora Lindqvist"],

  // The store's regulars: the daily matches' opponents.
  "opponents": [
    { "id": "rosa", "name": "Rosa Quintero", "style": "Attacks every turn and dares you to keep up.", "decks": ["fdn-br", "m19-rg", "ori-rg"], "tier": 1, "rival": true },
    { "id": "theo", "name": "Theo Marsh", "style": "Big creatures, bigger smiles.", "decks": ["hob-gw", "m10-gw", "fdn-gw"], "tier": 0 },
    { "id": "ines", "name": "Ines Calder", "style": "Counts every card and answers every threat.", "decks": ["fdn-ub", "m19-ub", "ori-ub"], "tier": 1 },
    { "id": "kofi", "name": "Kofi Mensah", "style": "Flyers, tricks and a grin when the trick works.", "decks": ["fdn-wu", "m19-wu", "hob-wu"], "tier": 0 },
    { "id": "lena", "name": "Lena Varga", "style": "Plays whatever came out of the last booster.", "decks": ["hob-br", "m10-br", "ori-br"], "tier": 0 },
    { "id": "sam", "name": "Sam Okafor", "style": "New to the game and learning fast.", "decks": ["m10-rg", "m10-wu", "m19-gw"], "tier": 0 },
    { "id": "marcus", "name": "Marcus Bell", "style": "The store's old-timer; has seen every trick twice.", "decks": ["m10-ub", "ori-gw", "ori-wu"], "tier": 2 },
    { "id": "yuki", "name": "Yuki Arai", "style": "Saturday tournament regular, practicing on weekdays.", "decks": ["fdn-rg", "m19-br", "hob-rg"], "tier": 3, "rival": true }
