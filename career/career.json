    "greetings": [
      "Hey! Wanna play for keeps? Here's what I've got:",
      "Yo! Up for an ante game? Take your pick:",
      "Looking for a real game? I'll put one of these up:",
      "Oh hey, perfect timing. Feeling lucky? These are on the table:",
      "Ante match? I'm in. Here's what I'm willing to lose... not that I will.",
      "Sup! I brought some goodies. Pick one and let's play for it:",
      "You again! Ready to lose a card? Kidding. Here's my offer:",
      "Let's make this interesting. Any of these catch your eye?"
    ],
    "askStake": [
      "Good pick. What are you putting up?",
      "Nice choice. And what do I get if I win?",
      "Alright, show me what you've got.",
      "Ooh, bold. What's on your side of the table?",
      "Fair enough. Your turn: what's your stake?",
      "Sure thing. Now, what are you risking?"
    ],
    "accepts": [
      "Deal!",
      "You're on!",
      "Now we're talking. Deal.",
      "Fair enough, I'll take that bet.",
      "Sounds good to me!",
      "Alright, it's a deal. Prepare to lose it!"
    ],
    "farewells": [
      "See you at the LGS, mate!",
      "Meet you at the store. Bring your A game!",
      "See you at the LGS! Shuffle well.",
      "Cool, I'm heading to the store now. See you there!",
      "Grab a table at the LGS, I'll be right there.",
      "See you at the store. No take-backs!"
    ],
    // What a regular says turning a stake down.
    "declines": [
      "Hey dude, that's not worth it.",
      "Come on, you can do better than that.",
      "For that? No way.",
      "I'm not risking my card for that one.",
      "Nice try. Put something real on the table.",
      "Ha! Keep it, I'll pass.",
      "That's a bulk card and you know it.",
      "Not even close, buddy.",
      "I've got three of those in my trade binder. Pass.",
      "Make it worth my while and we'll talk.",
      "Lol, no. Try again.",
      "You're joking, right? That's not even close.",
      "I'd be robbing myself. Got anything better?",
      "Hmm, nope. That's way under what I'm putting up."
