                "commander-white", "commander-blue", "commander-black", "commander-red", "commander-green"],
      "prizes": [
        { "wins": 2, "boosters": 3, "reputation": 8 },
        { "wins": 1, "boosters": 2, "reputation": 5 },
        { "wins": 0, "boosters": 1, "reputation": 3 }
      ]
    },
    {
      "id": "saturday", "name": "Saturday tournament", "when": "Saturday", "kind": "constructed",
      "players": 8, "rounds": 3, "bestOf": 1, "entry": 2000,
      "prizes": [
        { "place": 1, "cash": 10000, "boosters": 4, "tokens": 1, "reputation": 15 },
        { "place": 2, "cash": 5000, "boosters": 2, "reputation": 10 },
        { "place": 4, "cash": 2000, "boosters": 1, "reputation": 6 },
        { "reputation": 2 }
      ]
    },
    {
      // A local event, no qualification: open to anyone and cheap, a way to earn the money for the regional qualifier.
      "id": "championship", "name": "Monthly championship", "when": "lastSunday", "kind": "constructed",
      "players": 16, "rounds": 4, "bestOf": 3, "entry": 2500,
      "prizes": [
        { "place": 1, "cash": 15000, "boosters": 5, "reputation": 25 },
        { "place": 2, "cash": 8000, "boosters": 3, "reputation": 15 },
        { "place": 4, "cash": 4000, "boosters": 2, "reputation": 10 },
        { "place": 8, "cash": 1500, "boosters": 1, "reputation": 5 },
        { "reputation": 3 }
      ]
    },
    {
      // The circuit's first step: the first weekend of every month, Friday to Sunday (the rounds can be played on any of
      // the three days). Swiss rounds by attendance (16 to 64 players), best of three, then a top 8. The winner (and the
      // finalist when 33 or more played) is invited to the next regional championship.
      "id": "regional-qualifier", "name": "Regional qualifier", "when": "firstFriday", "days": 3, "kind": "constructed", "format": "standard",
      "players": 16, "playersMax": 64, "rounds": 0, "bestOf": 3, "topCut": 8, "roundMinutes": 50, "entry": 4000,
