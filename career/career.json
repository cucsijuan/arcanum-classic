        { "place": 1, "cash": 25000, "boosters": 6, "reputation": 40, "qualifies": "regional-championship" },
        { "place": 2, "minPlayers": 33, "cash": 12000, "boosters": 4, "reputation": 25, "qualifies": "regional-championship" },
