{
  "name": "Vow to Erebor",
  "spell": {
    "targets": [
      "creature:you"
    ],
    "effects": [
      {
        "untap": "target"
      },
      {
        "pump": [
          2,
          2
        ],
        "what": "target"
      },
      {
        "if": {
          "target": "target",
          "is": {
            "subtype": "Dwarf"
          }
        },
        "then": [
          {
            "attach": {
              "choose": {
                "subtype": "Equipment"
              }
            },
            "to": "target"
          }
        ]
      }
    ],
    "text": "Untap target creature you control. It gets +2/+2 until end of turn. If it's a Dwarf, you may attach an Equipment you control to it."
  }
}
