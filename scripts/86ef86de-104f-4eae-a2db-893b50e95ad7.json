{
  "name": "Tokka & Rahzar, Terrible Twos",
  "abilities": [
    {
      "trigger": "anyPlayerCastsSpell",
      "if": {
        "atLeast": {
          "diff": [
            "triggerAmount",
            "manaSpent"
          ]
        },
        "value": 1
      },
      "effects": [
        {
          "damage": 3,
          "to": "triggeredPlayer"
        }
      ],
      "text": "Whenever a player casts a spell, if the amount of mana spent to cast it was less than its mana value, Tokka & Rahzar deal 3 damage to that player."
    }
  ]
}
