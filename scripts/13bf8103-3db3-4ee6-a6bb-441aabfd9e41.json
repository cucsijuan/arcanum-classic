          "creature"
        ],
        "other": true,
        "token": false,
        "controller": "you"
      },
      "effects": [
        {
          "endure": "countersOnSelf",
          "what": "triggered"
        }
      ],
      "text": "Whenever another nontoken creature you control enters, it endures X, where X is the number of counters on this creature."
    }
  ]
