{
  "name": "Splash Portal",
  "spell": {
    "targets": [
      "creature:you"
    ],
    "effects": [
      {
        "if": {
          "target": "target",
          "is": {
            "anyOf": [
              {
                "subtype": "Bird"
              },
              {
                "subtype": "Frog"
              },
              {
                "subtype": "Otter"
              },
              {
                "subtype": "Rat"
              }
            ]
          }
        },
        "then": [
          {
            "blink": "target"
          },
          {
            "draw": 1
          }
        ],
        "else": [
          {
            "blink": "target"
          }
        ]
      }
    ],
    "text": "Exile target creature you control, then return it to the battlefield under its owner's control. If that creature is a Bird, Frog, Otter, or Rat, draw a card."
  }
}
