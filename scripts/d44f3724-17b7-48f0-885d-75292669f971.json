{
  "name": "Fiery Annihilation",
  "spell": {
    "targets": [
      "creature",
      {
        "kind": "artifact",
        "optional": true,
        "filter": {
          "subtype": "Equipment"
        },
        "text": "up to one target Equipment attached to that creature"
      }
    ],
    "effects": [
      {
        "exileIfDies": "target"
      },
      {
        "damage": 5,
        "to": "target"
      },
      {
        "if": {
          "targetAttachedTo": "target2",
          "to": "target"
        },
        "then": [
          {
            "exile": "target2"
          }
        ]
      }
    ]
  }
}
