{
  "name": "Petrified Hamlet",
  "replaces": [
    "StopsChosenNameAbilities"
  ],
  "abilities": [
    {
      "trigger": "enters",
      "effects": [
        {
          "chooseLandCardName": true
        }
      ],
      "text": "When this land enters, choose a land card name."
    },
    {
      "static": {
