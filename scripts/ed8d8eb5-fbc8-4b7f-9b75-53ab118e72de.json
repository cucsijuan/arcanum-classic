{
  "name": "Unholy Hunger",
  "spell": {
    "targets": [
      "creature"
    ],
    "effects": [
      {
        "destroy": "target"
      },
      {
        "if": {
          "graveyard": 2,
          "filter": {
            "types": [
              "instant",
              "sorcery"
            ]
          }
        },
        "then": [
          {
            "gainLife": 2
          }
        ]
      }
    ],
    "text": "Destroy target creature. Spell mastery — If there are two or more instant and/or sorcery cards in your graveyard, you gain 2 life."
  }
}
