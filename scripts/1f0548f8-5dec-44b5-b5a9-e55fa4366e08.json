{
  "name": "Enchanter's Bane",
  "abilities": [
    {
      "trigger": "endStep",
      "targets": [
        "enchantment"
      ],
      "effects": [
        {
          "unlessSacrificesTarget": "target",
          "otherwise": [
            {
              "damage": {
                "manaValue": "target"
              },
