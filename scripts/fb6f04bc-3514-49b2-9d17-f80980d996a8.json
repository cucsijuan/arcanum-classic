{
  "name": "Olog-hai Crusher",
  "abilities": [
    {
      "static": {
        "affects": "self",
        "keywords": [
          "Can't block"
        ],
        "while": {
          "not": {
            "control": {
              "types": [
                "creature"
              ],
              "anyOf": [
                {
                  "subtype": "Goblin"
                },
                {
                  "subtype": "Orc"
                }
              ]
            }
          }
        }
      },
      "text": "This creature can't block unless you control a Goblin or Orc."
    }
  ]
}
