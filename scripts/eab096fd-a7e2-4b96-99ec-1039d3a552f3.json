{
  "name": "Bolg, Erebor's Reckoning",
  "abilities": [
    {
      "trigger": "eachBeginCombat",
      "effects": [
        {
          "pump": [
            2,
            2
          ],
          "what": {
            "each": {
              "types": [
                "creature"
              ],
              "controller": "you",
              "other": true,
              "anyOf": [
                {
                  "subtype": "Goblin"
                },
                {
                  "subtype": "Orc"
                }
              ]
            }
          }
        },
        {
          "pump": [
            -1,
            -1
          ],
          "what": {
            "each": {
              "types": [
                "creature"
              ],
              "controller": "opponent"
            }
          }
        }
      ],
      "text": "At the beginning of each combat, other Goblins and Orcs you control get +2/+2 until end of turn. Creatures your opponents control get -1/-1 until end of turn."
    }
  ]
}
