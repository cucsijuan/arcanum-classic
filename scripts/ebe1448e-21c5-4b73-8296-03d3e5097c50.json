{
  "name": "Will of the Temur",
  "spell": {
    "text": "Choose one. If you control a commander as you cast this spell, you may choose both instead.",
    "extraModeIf": {
      "control": {
        "commander": true
      }
    },
    "modes": [
      {
        "text": "Create a token that's a copy of target permanent, except it's a 4/4 Dragon creature with flying in addition to its other types.",
        "targets": [
          "permanent"
        ],
        "effects": [
          {
            "copy": "target",
            "setPower": 4,
            "setToughness": 4,
            "addTypes": [
              "creature"
            ],
            "addSubtypes": [
              "Dragon"
            ],
            "addKeywords": [
              "Flying"
            ]
          }
        ]
      },
      {
        "text": "Target player draws cards equal to the greatest mana value among permanents you control.",
        "targets": [
          "player"
        ],
        "effects": [
          {
            "draw": {
              "greatestManaValue": {
                "controller": "you"
              }
            },
            "who": "target"
          }
        ]
      }
    ]
  }
}
