{
  "name": "Grave Venerations",
  "abilities": [
    {
      "trigger": "enters",
      "effects": [
        {
          "becomeMonarch": "you"
        }
      ],
      "text": "When this enchantment enters, you become the monarch."
    },
    {
      "trigger": "endStep",
      "if": "monarch",
      "targets": [
        {
          "kind": "graveyardCard",
          "controller": "you",
          "optional": true,
          "filter": {
            "types": [
              "creature"
            ]
          },
          "text": "up to one target creature card from your graveyard"
        }
      ],
      "effects": [
        {
          "bounce": "target"
        }
      ],
      "text": "At the beginning of your end step, if you're the monarch, return up to one target creature card from your graveyard to your hand."
    },
    {
      "trigger": "creatureDies",
      "filter": {
        "types": [
          "creature"
        ],
        "controller": "you"
      },
      "effects": [
        {
          "loseLife": 1,
          "who": "opponents"
        },
        {
          "gainLife": 1
        }
      ],
      "text": "Whenever a creature you control dies, each opponent loses 1 life and you gain 1 life."
    }
  ]
}
