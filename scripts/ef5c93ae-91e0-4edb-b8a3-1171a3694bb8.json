{
  "name": "River Kelpie",
  "abilities": [
    {
      "trigger": "permanentEnters",
      "effects": [
        {
          "draw": 1
        }
      ],
      "text": "Whenever this creature or another permanent enters from a graveyard, draw a card.",
      "filter": {
        "controller": "any",
        "fromGraveyard": true
      }
    },
    {
      "trigger": "anyPlayerCastsSpell",
      "effects": [
        {
          "draw": 1
        }
      ],
      "text": "Whenever a player casts a spell from a graveyard, draw a card.",
      "filter": {
        "fromGraveyard": true
      }
    },
    {
      "trigger": "dies",
      "effects": [
        {
          "reanimate": "self",
          "ownerControl": true,
          "counters": 1,
          "counterKind": "-1/-1"
        }
      ],
      "text": "Persist (When this creature dies, if it had no -1/-1 counters on it, return it to the battlefield under its owner's control with a -1/-1 counter on it.)",
      "if": {
        "not": {
          "sourceHadCounters": "-1/-1"
        }
      }
    }
  ]
}
