{
  "name": "Will of the Abzan",
  "spell": {
    "text": "Choose one. If you control a commander as you cast this spell, you may choose both instead.",
    "extraModeIf": {
      "control": {
        "commander": true
      }
    },
    "modes": [
      {
        "text": "Any number of target opponents each sacrifice a creature with the greatest power among creatures that player controls and lose 3 life.",
        "targets": [
          {
            "kind": "opponent",
            "anyNumber": true,
            "text": "any number of target opponents"
          }
        ],
        "effects": [
          {
            "sacrifice": 1,
            "filter": {
              "types": [
                "creature"
              ],
              "greatestPower": true
            },
            "who": "eachTarget"
          },
          {
            "loseLife": 3,
            "who": "eachTarget"
          }
        ]
      },
      {
        "text": "Return target creature card from your graveyard to the battlefield.",
        "targets": [
          {
            "kind": "graveyardCard",
            "controller": "you",
            "filter": {
              "types": [
                "creature"
              ]
            },
            "text": "target creature card from your graveyard"
          }
        ],
        "effects": [
          {
            "reanimate": "target"
          }
        ]
      }
    ]
  }
}
