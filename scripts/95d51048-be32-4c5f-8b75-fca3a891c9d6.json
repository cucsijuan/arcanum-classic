{
  "name": "Trade Route Envoy",
  "abilities": [
    {
      "trigger": "enters",
      "effects": [
        {
          "if": {
            "control": {
              "types": [
                "creature"
              ],
              "hasCounters": true
            }
          },
          "then": [
            {
              "draw": 1
            }
          ],
          "else": [
            {
              "counters": 1,
              "what": "self"
            }
          ]
        }
      ],
      "text": "When this creature enters, draw a card if you control a creature with a counter on it. If you don't draw a card this way, put a +1/+1 counter on this creature."
    }
  ]
}
