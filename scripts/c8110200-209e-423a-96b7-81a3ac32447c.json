{
  "name": "The Destined White Mage",
  "abilities": [
    {
      "cost": "{W}, {T}",
      "targets": [
        {
          "kind": "creature",
          "controller": "you",
          "filter": {
            "other": true
          }
        }
      ],
      "effects": [
        {
          "pump": [
            0,
            0
          ],
          "what": "target",
          "keywords": [
            "Lifelink"
          ]
        }
      ],
      "text": "{W}, {T}: Another target creature you control gains lifelink until end of turn."
    },
    {
      "trigger": "gainLife",
      "targets": [
        "creature:you"
      ],
      "effects": [
        {
          "if": "fullParty",
          "then": [
            {
              "counters": 3,
              "what": "target"
            }
          ],
          "else": [
            {
              "counters": 1,
              "what": "target"
            }
          ]
        }
      ],
      "text": "Whenever you gain life, put a +1/+1 counter on target creature you control. If you have a full party, put three +1/+1 counters on that creature instead."
    }
  ]
}
