{
  "name": "Karai, Future of the Foot",
  "abilities": [
    {
      "trigger": "combatDamageToPlayer",
      "targets": [
        {
          "kind": "graveyardCard",
          "controller": "you",
          "filter": {
            "types": [
              "creature"
            ]
          }
        }
      ],
      "effects": [
        {
          "if": "sneakedThisTurn",
          "then": [
            {
              "reanimate": "target"
            }
          ],
          "else": [
            {
              "bounce": "target"
            }
          ]
        }
      ],
      "text": "Whenever Karai deals combat damage to a player, return target creature card from your graveyard to your hand. If her sneak cost was paid this turn, instead return that card to the battlefield."
    }
  ]
}
