{
  "name": "Meathook Massacre II",
  "abilities": [
    {
      "trigger": "enters",
      "effects": [
        {
          "sacrifice": "X",
          "who": "everyone"
        }
      ],
      "text": "When Meathook Massacre II enters, each player sacrifices X creatures."
    },
    {
      "trigger": "creatureDies",
      "filter": {
        "types": [
          "creature"
        ],
        "controller": "you"
      },
      "effects": [
        {
          "mayPay": "Pay 3 life to return that card under your control with a finality counter?",
          "cost": {
            "life": 3
          },
          "effects": [
            {
              "reanimate": "triggered",
              "counters": 1,
              "counterKind": "finality"
            }
          ]
        }
      ],
      "text": "Whenever a creature you control dies, you may pay 3 life. If you do, return that card under your control with a finality counter on it."
    },
    {
      "trigger": "creatureDies",
      "filter": {
        "types": [
          "creature"
        ],
        "controller": "opponent"
      },
      "effects": [
        {
          "unless": "triggeredController",
          "options": [
            {
              "life": 3
            }
          ],
          "otherwise": [
            {
              "reanimate": "triggered",
              "counters": 1,
              "counterKind": "finality"
            }
          ]
        }
      ],
      "text": "Whenever a creature an opponent controls dies, they may pay 3 life. If they don't, return that card under your control with a finality counter on it."
    }
  ]
}
