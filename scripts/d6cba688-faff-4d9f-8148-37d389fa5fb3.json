{
  "name": "Aerith, Last Ancient",
  "abilities": [
    {
      "trigger": "endStep",
      "effects": [
        {
          "if": {
            "gainedLife": 7
          },
          "then": [
            {
              "reanimate": "target"
            }
          ],
          "else": [
            {
              "bounce": "target"
            }
          ]
        }
      ],
      "text": "Raise — At the beginning of your end step, if you gained life this turn, return target creature card from your graveyard to your hand. If you gained 7 or more life this turn, return that card to the battlefield instead.",
      "if": "gainedLife",
      "targets": [
        {
          "kind": "graveyardCard",
          "controller": "you",
          "filter": {
            "types": [
              "creature"
            ]
          }
        }
      ]
    }
  ]
}
