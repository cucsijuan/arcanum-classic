{
  "name": "Invasive Maneuvers",
  "spell": {
    "targets": [
      "creature"
    ],
    "effects": [
      {
        "if": {
          "control": {
            "subtype": "Spacecraft"
          }
        },
        "then": [
          {
            "damage": 5,
            "to": "target"
          }
