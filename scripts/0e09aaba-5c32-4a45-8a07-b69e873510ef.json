{
  "name": "Trail of Mystery",
  "abilities": [
    {
      "trigger": "permanentEnters",
      "filter": {
        "types": [
          "creature"
        ],
        "controller": "you",
        "faceDown": true
      },
      "effects": [
        {
          "may": "Search your library for a basic land card?",
          "effects": [
            {
              "search": {
                "supertype": "basic",
                "types": [
                  "land"
                ]
              },
              "count": 1,
              "reveal": true,
              "to": "hand"
            }
          ]
        }
      ],
      "text": "Whenever a face-down creature you control enters, you may search your library for a basic land card, reveal it, put it into your hand, then shuffle."
    },
    {
      "trigger": "yourPermanentTurnedFaceUp",
      "filter": {
        "controller": "you",
        "types": [
          "creature"
        ]
      },
      "effects": [
        {
          "pump": [
            2,
            2
          ],
          "what": "triggered"
        }
      ],
      "text": "Whenever a permanent you control is turned face up, if it's a creature, it gets +2/+2 until end of turn."
    }
  ]
}
