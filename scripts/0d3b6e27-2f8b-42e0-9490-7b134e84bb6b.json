{
  "name": "Retched Wretch",
  "abilities": [
    {
      "trigger": "dies",
      "if": {
        "sourceHadCounters": "-1/-1"
      },
      "effects": [
        {
          "reanimate": "self",
          "ownerControl": true
        },
        {
          "become": "enteredThisWay",
          "permanent": true,
          "loseAbilities": true
        }
      ],
      "text": "When this creature dies, if it had a -1/-1 counter on it, return it to the battlefield under its owner's control and it loses all abilities."
    }
  ]
}
