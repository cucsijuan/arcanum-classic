{
  "name": "Andúril, Flame of the West",
  "abilities": [
    {
      "static": {
        "affects": "equipped",
        "pump": [
          3,
          1
        ]
      },
      "text": "Equipped creature gets +3/+1."
    },
    {
      "trigger": "creatureAttacks",
      "filter": {
        "types": [
          "creature"
        ],
        "controller": "any",
        "attachedToSource": true
      },
      "effects": [
        {
          "if": {
            "triggered": {
              "supertype": "legendary"
            }
          },
          "then": [
            {
              "tokens": 2,
              "token": {
                "name": "Spirit",
                "types": "Creature — Spirit",
                "colors": [
                  "W"
                ],
                "power": 1,
                "toughness": 1,
                "keywords": [
                  "Flying"
                ]
              },
              "tapped": true,
              "attacking": true
            }
          ],
          "else": [
            {
              "tokens": 2,
              "token": {
                "name": "Spirit",
                "types": "Creature — Spirit",
                "colors": [
                  "W"
                ],
                "power": 1,
                "toughness": 1,
                "keywords": [
                  "Flying"
                ]
              },
              "tapped": true
            }
          ]
        }
      ],
      "text": "Whenever equipped creature attacks, create two tapped 1/1 white Spirit creature tokens with flying. If that creature is legendary, instead create two of those tokens that are tapped and attacking."
    }
  ]
}
