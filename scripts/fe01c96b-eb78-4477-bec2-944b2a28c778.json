{
  "name": "Eddie Brock // Venom, Lethal Protector",
  "abilities": [
    {
      "trigger": "enters",
      "targets": [
        {
          "kind": "graveyardCard",
          "controller": "you",
          "filter": {
            "types": [
              "creature"
            ],
            "maxManaValue": 1
          },
          "text": "target creature card with mana value 1 or less from your graveyard"
        }
      ],
      "effects": [
        {
          "reanimate": "target"
        }
      ],
      "text": "When Eddie Brock enters, return target creature card with mana value 1 or less from your graveyard to the battlefield."
    },
    {
      "cost": "{3}{B}{R}{G}",
      "sorcery": true,
      "effects": [
        {
          "transform": "self"
        }
      ],
      "text": "{3}{B}{R}{G}: Transform Eddie Brock. Activate only as a sorcery."
    }
  ],
  "back": {
    "abilities": [
      {
        "trigger": "attacks",
        "effects": [
          {
            "may": "Sacrifice another creature?",
            "effects": [
              {
                "sacrifice": 1,
                "filter": {
                  "types": [
                    "creature"
                  ],
                  "other": true
                }
              },
              {
                "if": "youSacrificed",
                "then": [
                  {
                    "draw": "sacrificedManaValue"
                  },
                  {
                    "putFromHand": {
                      "types": [
                        "artifact",
                        "creature",
                        "enchantment",
                        "land",
                        "planeswalker",
                        "battle"
                      ]
                    },
                    "one": true,
                    "maxManaValue": "sacrificedManaValue"
                  }
                ]
              }
            ]
          }
        ],
        "text": "Whenever Venom attacks, you may sacrifice another creature. If you do, draw X cards, then you may put a permanent card with mana value X or less from your hand onto the battlefield, where X is the sacrificed creature's mana value."
      }
    ]
  }
}
