{
  "name": "Send to Sleep",
  "spell": {
    "targetRule": "allDifferent",
    "targets": [
      {
        "kind": "creature",
        "optional": true,
        "text": "up to two target creatures"
      },
      {
        "kind": "creature",
        "optional": true,
        "text": "up to two target creatures"
      }
    ],
    "effects": [
      {
        "tap": "eachTarget"
      },
      {
        "if": {
          "graveyard": 2,
          "filter": {
            "types": [
              "instant",
              "sorcery"
            ]
          }
        },
        "then": [
          {
            "skipNextUntap": "eachTarget"
          }
        ]
      }
    ],
    "text": "Tap up to two target creatures. Spell mastery — If there are two or more instant and/or sorcery cards in your graveyard, those creatures don't untap during their controllers' next untap steps."
  }
}
