{
  "name": "Dazzling Denial",
  "spell": {
    "targets": [
      "spell"
    ],
    "effects": [
      {
        "if": {
          "control": {
            "subtype": "Bird"
          }
        },
        "then": [
          {
            "counter": "target",
            "unlessPays": "{4}"
          }
        ],
        "else": [
          {
            "counter": "target",
            "unlessPays": "{2}"
          }
        ]
      }
    ],
    "text": "Counter target spell unless its controller pays {2}. If you control a Bird, counter that spell unless its controller pays {4} instead."
  }
}
