      "playerOrPlaneswalker"
    ],
    "effects": [
      {
        "simultaneously": [
          {
            "damage": 4,
            "to": "target"
          },
          {
            "damage": 1,
            "to": {
              "each": {
                "types": [
                  "creature"
                ],
