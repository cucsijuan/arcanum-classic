{
  "name": "Perch Protection",
  "gift": "extraTurn",
  "spell": {
    "effects": [
      {
        "tokens": 4,
        "token": {
          "name": "Bird",
          "types": "Creature — Bird",
          "power": 2,
          "toughness": 2,
          "colors": [
            "U"
          ],
          "keywords": [
            "Flying"
          ]
        }
      },
      {
        "if": "giftPromised",
        "then": [
          {
            "phaseOut": {
              "each": {
                "controller": "you"
              }
            }
          },
          {
            "protectionAndLifeLock": "you"
          }
        ]
      },
      {
        "exileThisSpell": true
      }
    ],
    "text": "Create four 2/2 blue Bird creature tokens with flying. If the gift was promised, all permanents you control phase out, and until your next turn, your life total can't change and you gain protection from everything. Exile Perch Protection."
  }
}
