{
  "name": "Scouring Swarm",
  "abilities": [
    {
      "trigger": "youSacrifice",
      "effects": [
        {
          "if": {
            "graveyard": 7,
            "filter": {
              "types": [
                "land"
              ]
            }
          },
          "then": [
            {
              "copy": "self",
              "tapped": true
            }
          ],
          "else": [
            {
              "tokens": 1,
              "tapped": true,
              "token": {
                "name": "Insect",
                "types": "Creature — Insect",
                "colors": [
                  "B"
                ],
                "power": 1,
                "toughness": 1,
                "keywords": [
                  "Flying"
                ]
              }
            }
          ]
        }
      ],
      "text": "Whenever you sacrifice a land, create a tapped token that's a copy of this creature if seven or more land cards are in your graveyard. Otherwise, create a tapped 1/1 black Insect creature token with flying.",
      "filter": {
        "types": [
          "land"
        ]
      }
    }
  ]
}
