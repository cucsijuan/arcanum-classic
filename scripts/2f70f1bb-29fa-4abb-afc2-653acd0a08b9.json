{
  "name": "Woodfall Primus",
  "abilities": [
    {
      "trigger": "enters",
      "effects": [
        {
          "destroy": "target"
        }
      ],
      "text": "When this creature enters, destroy target noncreature permanent.",
      "targets": [
        {
          "kind": "permanent",
          "filter": {
            "not": [
              "creature"
            ]
          },
          "text": "target noncreature permanent"
        }
      ]
    },
    {
      "trigger": "dies",
      "effects": [
        {
          "reanimate": "self",
          "ownerControl": true,
          "counters": 1,
          "counterKind": "-1/-1"
        }
      ],
      "text": "Persist (When this creature dies, if it had no -1/-1 counters on it, return it to the battlefield under its owner's control with a -1/-1 counter on it.)",
      "if": {
        "not": {
          "sourceHadCounters": "-1/-1"
        }
      }
    }
  ]
}
