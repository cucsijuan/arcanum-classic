{
  "name": "The Gitrog Monster",
  "replaces": [
    "AdditionalLandPlay"
  ],
  "abilities": [
    {
      "trigger": "upkeep",
      "effects": [
        {
          "unless": "you",
          "options": [
            {
              "sacrifice": {
                "types": [
                  "land"
                ]
              }
            }
          ],
          "otherwise": [
            {
              "sacrificeIt": "self"
            }
          ]
        }
      ],
      "text": "At the beginning of your upkeep, sacrifice The Gitrog Monster unless you sacrifice a land."
    },
    {
      "trigger": "cardPutIntoYourGraveyard",
      "batched": true,
      "filter": {
        "types": [
          "land"
        ],
        "token": false
      },
      "effects": [
        {
          "draw": 1
        }
      ],
      "text": "Whenever one or more land cards are put into your graveyard from anywhere, draw a card."
    }
  ]
}
