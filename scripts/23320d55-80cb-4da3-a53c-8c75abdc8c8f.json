{
  "name": "Ignis Scientia",
  "abilities": [
    {
      "trigger": "enters",
      "effects": [
        {
          "lookAtTop": 6,
          "filter": {
            "types": [
              "land"
            ]
          },
          "take": 1,
          "to": "battlefield",
          "tapped": true
        }
      ],
      "text": "When Ignis Scientia enters, look at the top six cards of your library. You may put a land card from among them onto the battlefield tapped. Put the rest on the bottom of your library in a random order."
    },
    {
      "cost": "{1}{G}{U}, {T}",
      "effects": [
        {
          "exile": "target"
        },
        {
          "if": {
            "atLeast": {
              "exiled": {
                "types": [
                  "creature"
                ]
              }
            },
            "value": 1
          },
          "then": [
            {
              "tokens": 1,
              "token": "Food"
            }
          ]
        }
      ],
      "text": "I've Come Up with a New Recipe! — {1}{G}{U}, {T}: Exile target card from a graveyard. If a creature card was exiled this way, create a Food token.",
      "targets": [
        "graveyardCard"
      ]
    }
  ]
}
