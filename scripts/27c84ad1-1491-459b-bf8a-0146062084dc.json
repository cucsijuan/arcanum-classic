{
  "name": "Fiery Impulse",
  "spell": {
    "targets": [
      "creature"
    ],
    "effects": [
      {
        "if": {
          "graveyard": 2,
          "filter": {
            "types": [
              "instant",
              "sorcery"
            ]
          }
        },
        "then": [
          {
            "damage": 3,
            "to": "target"
          }
        ],
        "else": [
          {
            "damage": 2,
            "to": "target"
          }
        ]
      }
    ],
    "text": "Fiery Impulse deals 2 damage to target creature.\nSpell mastery — If there are two or more instant and/or sorcery cards in your graveyard, Fiery Impulse deals 3 damage instead."
  }
}
