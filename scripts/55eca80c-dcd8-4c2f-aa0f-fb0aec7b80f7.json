{
  "name": "Ophiomancer",
  "abilities": [
    {
      "trigger": "eachUpkeep",
      "if": {
        "not": {
          "control": {
            "subtype": "Snake"
          }
        }
      },
      "effects": [
        {
          "tokens": 1,
          "token": {
