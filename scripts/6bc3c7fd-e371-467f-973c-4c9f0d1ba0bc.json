{
  "name": "Ent's Fury",
  "spell": {
    "targets": [
      "creature:you",
      "creature:opponent"
    ],
    "effects": [
      {
        "if": {
          "target": "target",
          "is": {
            "minPower": 4
          }
        },
        "then": [
          {
            "counters": 1,
            "what": "target"
          }
        ]
      },
      {
        "pump": [
          1,
          1
        ],
        "what": "target"
      },
      {
        "fight": "target",
        "with": "target2"
      }
    ],
    "text": "Put a +1/+1 counter on target creature you control if its power is 4 or greater. Then that creature gets +1/+1 until end of turn and fights target creature you don't control."
  }
}
