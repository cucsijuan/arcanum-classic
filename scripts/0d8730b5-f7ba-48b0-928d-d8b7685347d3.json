{
  "name": "Case of the Uneaten Feast",
  "abilities": [
    {
      "trigger": "creatureEnters",
      "filter": {
        "types": [
          "creature"
        ],
        "controller": "you"
      },
      "effects": [
        {
          "gainLife": 1
        }
      ],
      "text": "Whenever a creature you control enters, you gain 1 life."
    },
    {
      "trigger": "endStep",
      "if": {
        "all": [
          {
            "not": "solved"
          },
          {
            "gainedLife": 5
          }
        ]
      },
      "effects": [
        {
          "solve": true
        }
      ],
      "text": "To solve — You've gained 5 or more life this turn. (If unsolved, solve at the beginning of your end step.)"
    },
    {
      "cost": "sacrifice",
      "activateIf": "solved",
      "effects": [
        {
          "castFromGraveyardThisTurnEach": {
            "types": [
              "creature"
            ]
          }
        }
      ],
      "text": "Solved — Sacrifice this Case: Creature cards in your graveyard gain \"You may cast this card from your graveyard\" until end of turn."
    }
  ]
}
