{
  "name": "Torch the Tower",
  "spell": {
    "targets": [
      {
        "kind": "permanent",
        "filter": {
          "anyOf": [
            {
              "types": [
                "creature"
              ]
            },
            {
              "types": [
                "planeswalker"
              ]
            }
          ]
        },
        "text": "target creature or planeswalker"
      }
    ],
    "effects": [
      {
        "if": "additionalCostPaid",
        "then": [
          {
            "damage": 3,
            "to": "target"
          },
          {
            "scry": 1
          }
        ],
        "else": [
          {
            "damage": 2,
            "to": "target"
          }
        ]
      },
      {
        "if": {
          "target": "target",
          "is": {
            "damagedBySource": true
          }
        },
        "then": [
          {
            "exileIfDies": "target"
          }
        ]
      }
    ],
    "text": "Torch the Tower deals 2 damage to target creature or planeswalker. If this spell was bargained, instead it deals 3 damage to that permanent and you scry 1. If a permanent dealt damage by Torch the Tower would die this turn, exile it instead."
  }
}
