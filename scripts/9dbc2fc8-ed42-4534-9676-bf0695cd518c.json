{
  "name": "You're Not Alone",
  "spell": {
    "targets": [
      "creature"
    ],
    "effects": [
      {
        "if": {
          "control": {
            "types": [
              "creature"
            ]
          },
          "count": 3
        },
        "then": [
          {
            "pump": [
              4,
              4
            ],
            "what": "target"
          }
        ],
        "else": [
          {
            "pump": [
              2,
              2
            ],
            "what": "target"
          }
        ]
      }
    ],
    "text": "Target creature gets +2/+2 until end of turn. If you control three or more creatures, it gets +4/+4 until end of turn instead."
  }
}
