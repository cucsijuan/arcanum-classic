        {
          // A second such trigger finds Nissa already turned over (a new object): it does nothing (rule 400.7).
          "if": {
            "sourceIs": {
              "transformed": false
            }
          },
          "then": [
            {
              "blink": "self",
              "transformed": true
            }
          ]
        }
      ],
      "text": "Whenever a land you control enters, if you control seven or more lands, exile Nissa, then return her to the battlefield transformed under her owner's control."
    }
