              "creature"
            ],
            "anyOf": [
              {
                "subtype": "Goblin"
              },
              {
                "subtype": "Orc"
              }
            ]
          }
        }
      },
      "text": "Equipped creature has first strike as long as it's blocking or blocked by a Goblin or Orc."
