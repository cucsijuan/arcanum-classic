{
  "name": "Dawnhand Eulogist",
  "abilities": [
    {
      "trigger": "enters",
      "effects": [
        {
          "mill": 3
        },
        {
          "if": {
            "graveyard": 1,
            "filter": {
              "subtype": "Elf"
            }
          },
          "then": [
            {
              "loseLife": 2,
              "who": "opponents"
            },
            {
              "gainLife": 2
            }
          ]
        }
      ],
      "text": "When this creature enters, mill three cards. Then if there is an Elf card in your graveyard, each opponent loses 2 life and you gain 2 life."
    }
  ]
}
