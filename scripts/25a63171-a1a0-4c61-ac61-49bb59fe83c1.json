{
  "name": "Thought-Stalker Warlock",
  "abilities": [
    {
      "trigger": "enters",
      "targets": [
        "opponent"
      ],
      "effects": [
        {
          "if": {
            "targetLostLife": "target"
          },
          "then": [
            {
              "discardChosen": "target",
              "filter": {
                "not": [
                  "land"
                ]
              }
            }
          ],
          "else": [
            {
              "discard": 1,
              "who": "target"
            }
          ]
        }
      ],
      "text": "When this creature enters, choose target opponent. If they lost life this turn, they reveal their hand, you choose a nonland card from it, and they discard that card. Otherwise, they discard a card."
    }
  ]
}
