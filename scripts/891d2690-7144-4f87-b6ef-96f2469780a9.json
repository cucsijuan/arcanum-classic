{
  "name": "Righteous Valkyrie",
  "abilities": [
    {
      "trigger": "creatureEnters",
      "filter": {
        "types": [
          "creature"
        ],
        "controller": "you",
        "other": true,
        "anyOf": [
          {
            "subtype": "Angel"
          },
          {
            "subtype": "Cleric"
          }
        ]
      },
      "effects": [
        {
          "gainLife": "triggeredToughness"
        }
      ],
      "text": "Whenever another Angel or Cleric you control enters, you gain life equal to that creature's toughness."
    },
    {
      "static": {
        "affects": "creatures:you",
        "pump": [
          2,
          2
        ],
        "while": {
          "lifeAboveStarting": 7
        }
      },
      "text": "As long as you have at least 7 life more than your starting life total, creatures you control get +2/+2."
    }
  ]
}
