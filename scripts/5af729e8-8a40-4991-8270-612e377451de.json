{
  "name": "Wick, the Whorled Mind",
  "abilities": [
    {
      "trigger": "creatureEnters",
      "filter": {
        "types": [
          "creature"
        ],
        "subtype": "Rat",
        "controller": "you"
      },
      "effects": [
        {
          "if": {
            "not": {
              "control": {
                "subtype": "Snail"
              }
            }
          },
          "then": [
            {
              "tokens": 1,
              "token": {
                "name": "Snail",
                "types": "Creature — Snail",
                "power": 1,
                "toughness": 1,
                "colors": [
                  "B"
                ],
                "keywords": []
              }
            }
          ],
          "else": [
            {
              "counters": 1,
              "what": {
                "choose": {
                  "subtype": "Snail"
                }
              }
            }
          ]
        }
      ],
      "text": "Whenever Wick or another Rat you control enters, create a 1/1 black Snail creature token if you don't control a Snail. Otherwise, put a +1/+1 counter on a Snail you control."
    },
    {
      "cost": "{U}{B}{R}, sacrificeAny:Snail",
      "effects": [
        {
          "damage": "sacrificedPower",
          "to": "opponents"
        },
        {
          "draw": "sacrificedPower"
        }
      ],
      "text": "{U}{B}{R}, Sacrifice a Snail: Wick deals damage equal to the sacrificed creature's power to each opponent. Then draw cards equal to the sacrificed creature's power."
    }
  ]
}
