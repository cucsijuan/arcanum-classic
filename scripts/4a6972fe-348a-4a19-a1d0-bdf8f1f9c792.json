{
  "name": "Garruk, Veiled Butcher",
  "replaces": [
    "OpponentsCreaturesExiledInsteadOfDying"
  ],
  "abilities": [
    {
      "cost": "+2",
      "targets": [
        {
          "kind": "creature",
          "optional": true,
          "text": "up to one target creature"
        }
      ],
      "effects": [
        {
          "pump": [
            -4,
            -1
          ],
          "what": "target",
          "untilYourNextTurn": true
        }
      ],
      "text": "+2: Up to one target creature gets -4/-1 until your next turn."
    },
    {
      "cost": "-2",
      "effects": [
        {
          "sacrifice": 1,
          "filter": {
            "types": [
              "creature"
            ]
          },
          "who": "everyone"
        },
        {
          "if": "youSacrificed",
          "then": [
            {
              "tokens": 1,
              "token": {
                "name": "Beast",
                "types": "Creature — Beast",
                "power": 4,
                "toughness": 4,
                "colors": [
                  "G"
                ],
                "keywords": [
                  "Trample"
                ]
              }
            }
          ]
        }
      ],
      "text": "−2: Each player sacrifices a creature of their choice. If you sacrificed a creature this way, create a 4/4 green Beast creature token with trample."
    },
    {
      "cost": "-3",
      "effects": [
        {
          "discard": 2,
          "who": "opponents"
        },
        {
          "draw": {
            "opponentsWhoDiscardedFewer": 2,
            "filter": {
              "not": [
                "land"
              ]
            }
          }
        }
      ],
      "text": "−3: Each opponent discards two cards. For each opponent who didn't discard two nonland cards this way, you draw a card."
    }
  ]
}
