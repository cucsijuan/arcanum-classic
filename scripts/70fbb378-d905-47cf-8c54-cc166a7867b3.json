{
  "name": "Kain, Traitorous Dragoon",
  "abilities": [
    {
      "static": {
        "affects": "self",
        "keywords": [
          "Flying"
        ],
        "while": "yourTurn"
      },
      "text": "Jump — During your turn, Kain has flying."
    },
    {
      "trigger": "combatDamageToPlayer",
      "effects": [
        {
          "gainControl": "self",
          "to": "triggeredPlayer"
        },
        {
          "if": {
            "atLeast": "controlGainedThisWay",
            "value": 1
          },
          "then": [
            {
              "draw": "triggerAmount"
            },
            {
              "tokens": "triggerAmount",
              "token": "Treasure",
              "tapped": true
            },
            {
              "loseLife": "triggerAmount"
            }
          ]
        }
      ],
      "text": "Whenever Kain deals combat damage to a player, that player gains control of Kain. If they do, you draw that many cards, create that many tapped Treasure tokens, then lose that much life."
    }
  ]
}
