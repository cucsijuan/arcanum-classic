{
  "name": "Tataru Taru",
  "abilities": [
    {
      "trigger": "enters",
      "targets": [
        "opponent"
      ],
      "effects": [
        {
          "draw": 1
        },
        {
          "opponentChooses": "Draw a card?",
          "yes": [
            {
              "draw": 1,
              "who": "triggeredPlayer"
            }
          ],
          "no": []
        }
      ],
      "text": "When Tataru Taru enters, you draw a card and target opponent may draw a card."
    },
    {
      "trigger": "opponentDraws",
      "when": {
        "not": "triggeredPlayerIsActive"
      },
      "oncePerTurn": true,
      "effects": [
        {
          "tokens": 1,
          "token": "Treasure",
          "tapped": true
        }
      ],
      "text": "Scions' Secretary — Whenever an opponent draws a card, if it isn't that player's turn, create a tapped Treasure token. This ability triggers only once each turn."
    }
  ]
}
