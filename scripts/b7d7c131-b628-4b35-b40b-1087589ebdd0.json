{
  "name": "Andúril, Narsil Reforged",
  "abilities": [
    {
      "trigger": "creatureAttacks",
      "filter": {
        "types": [
          "creature"
        ],
        "controller": "any",
        "attachedToSource": true
      },
      "effects": [
        {
          "if": "citysBlessing",
          "then": [
            {
              "counters": 2,
              "what": {
                "each": {
                  "types": [
                    "creature"
                  ],
                  "controller": "you"
                }
              }
            }
          ],
          "else": [
            {
              "counters": 1,
              "what": {
                "each": {
                  "types": [
                    "creature"
                  ],
                  "controller": "you"
                }
              }
            }
          ]
        }
      ],
      "text": "Whenever equipped creature attacks, put a +1/+1 counter on each creature you control. If you have the city's blessing, put two +1/+1 counters on each creature you control instead."
    }
  ]
}
