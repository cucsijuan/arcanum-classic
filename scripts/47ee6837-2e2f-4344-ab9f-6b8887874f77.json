{
  "name": "Colorstorm Stallion",
  "abilities": [
    {
      "trigger": "castSpell",
      "filter": {
        "types": [
          "instant",
          "sorcery"
        ]
      },
      "effects": [
        {
          "pump": [
            1,
            1
          ],
          "what": "self"
        },
        {
          "if": {
            "atLeast": "manaSpent",
            "value": 5
          },
          "then": [
            {
              "copy": "self"
            }
          ]
        }
      ],
      "text": "Opus — Whenever you cast an instant or sorcery spell, this creature gets +1/+1 until end of turn. If five or more mana was spent to cast that spell, create a token that's a copy of this creature."
    }
  ]
}
