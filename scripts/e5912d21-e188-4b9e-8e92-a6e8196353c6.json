{
  "name": "Mogis, God of Slaughter",
  "abilities": [
    {
      "static": {
        "affects": "self",
        "removeTypes": [
          "creature"
        ],
        "while": {
          "not": {
            "atLeast": {
              "devotion": [
                "B",
                "R"
              ]
            },
            "value": 7
          }
        }
      },
      "text": "As long as your devotion to black and red is less than seven, Mogis isn't a creature."
    },
    {
      "trigger": "eachUpkeep",
      "when": {
        "not": "yourTurn"
      },
      "effects": [
        {
          "unless": "triggeredPlayer",
          "options": [
            {
              "sacrifice": {
                "types": [
                  "creature"
                ]
              }
            }
          ],
          "otherwise": [
            {
              "damage": 2,
              "to": "triggeredPlayer"
            }
          ]
        }
      ],
      "text": "At the beginning of each opponent's upkeep, Mogis deals 2 damage to that player unless they sacrifice a creature of their choice."
    }
  ]
}
