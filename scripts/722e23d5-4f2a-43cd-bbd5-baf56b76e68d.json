{
  "name": "Parapet Thrasher",
  "abilities": [
    {
      "trigger": "creatureCombatDamageToPlayer",
      "filter": {
        "types": [
          "creature"
        ],
        "subtype": "Dragon",
        "controller": "you"
      },
      "batchedPerPlayer": true,
      "when": {
        "not": "triggeredPlayerIsYou"
      },
      "modesOncePerTurn": true,
      "text": "Whenever one or more Dragons you control deal combat damage to an opponent, choose one that hasn't been chosen this turn —",
      "modes": [
        {
          "text": "Destroy target artifact that opponent controls.",
          "targets": [
            {
              "kind": "artifact",
              "controlledByTriggeredPlayer": true,
              "text": "target artifact that opponent controls"
            }
          ],
          "effects": [
            {
              "destroy": "target"
            }
          ]
        },
        {
          "text": "This creature deals 4 damage to each other opponent.",
          "effects": [
            {
              "damage": 4,
              "to": "otherOpponents"
            }
          ]
        },
        {
          "text": "Exile the top card of your library. You may play it this turn.",
          "effects": [
            {
              "exileTopPlayable": 1
            }
          ]
        }
      ]
    }
  ]
}
