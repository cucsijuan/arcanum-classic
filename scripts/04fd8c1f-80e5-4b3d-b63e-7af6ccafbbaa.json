    "targets": [
      {
        "kind": "any",
        "onlyIfGiftPromised": true,
        "text": "any target"
      }
    ],
    "effects": [
      {
        "if": "giftPromised",
        "then": [
          {
            "damage": 1,
            "to": "target"
          }
        ]
      },
      {
        "damage": 2,
        "to": {
          "each": {
