{
  "name": "Starfield of Nyx",
  "abilities": [
    {
      "trigger": "upkeep",
      "targets": [
        {
          "kind": "graveyardCard",
          "controller": "you",
          "filter": {
            "types": [
              "enchantment"
            ]
          }
        }
      ],
      "effects": [
        {
          "may": "Return the enchantment card to the battlefield?",
          "effects": [
            {
              "reanimate": "target"
            }
          ]
        }
      ],
      "text": "At the beginning of your upkeep, you may return target enchantment card from your graveyard to the battlefield."
