            {
              "choose": {
                "types": [
                  "land"
                ],
                "controller": "you"
              }
            },
            {
              "bounce": "chosen"
            }
          ]
        }
      ],
      "text": "{3}{U}: Draw a card, then you may return a land you control to its owner's hand."
    }
  ]
