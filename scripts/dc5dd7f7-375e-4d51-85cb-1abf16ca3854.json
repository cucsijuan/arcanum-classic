{
  "name": "Emptiness",
  "abilities": [
    {
      "trigger": "enters",
      "if": {
        "spentToCast": "{W}{W}"
      },
      "targets": [
        {
          "kind": "graveyardCard",
          "controller": "you",
          "filter": {
            "types": [
              "creature"
            ],
            "maxManaValue": 3
          },
          "text": "target creature card with mana value 3 or less from your graveyard"
        }
      ],
      "effects": [
        {
          "reanimate": "target"
        }
      ],
      "text": "When this creature enters, if {W}{W} was spent to cast it, return target creature card with mana value 3 or less from your graveyard to the battlefield."
    },
    {
      "trigger": "enters",
      "if": {
        "spentToCast": "{B}{B}"
      },
      "targets": [
        {
          "kind": "creature",
          "optional": true,
          "text": "up to one target creature"
        }
      ],
      "effects": [
        {
          "counters": 3,
          "what": "target",
          "kind": "-1/-1"
        }
      ],
      "text": "When this creature enters, if {B}{B} was spent to cast it, put three -1/-1 counters on up to one target creature."
    }
  ]
}
