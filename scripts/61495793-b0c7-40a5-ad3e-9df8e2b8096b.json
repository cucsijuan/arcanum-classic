          {
            "kind": "spell",
            "controller": "you",
            "filter": {
              "types": [
                "creature"
              ]
            },
            "text": "target creature spell you control"
          }
        ],
        "effects": [
          {
            "copySpell": "target",
            "gainsHasteAndSacrifice": true
          }
        ]
      }
    ]
