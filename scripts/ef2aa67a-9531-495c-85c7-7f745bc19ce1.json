{
  "name": "The Destined Black Mage",
  "abilities": [
    {
      "cost": "{B}, {T}",
      "targets": [
        {
          "kind": "creature",
          "controller": "you",
          "filter": {
            "other": true
          }
        }
      ],
      "effects": [
        {
          "pump": [
            0,
            0
          ],
          "what": "target",
          "keywords": [
            "Deathtouch"
          ]
        }
      ],
      "text": "{B}, {T}: Another target creature you control gains deathtouch until end of turn."
    },
    {
      "trigger": "castSpell",
      "filter": {
        "not": [
          "creature"
        ]
      },
      "effects": [
        {
          "if": "fullParty",
          "then": [
            {
              "damage": 3,
              "to": "opponents"
            }
          ],
          "else": [
            {
              "damage": 1,
              "to": "opponents"
            }
          ]
        }
      ],
      "text": "Whenever you cast a noncreature spell, The Destined Black Mage deals 1 damage to each opponent. If you have a full party, it deals 3 damage to each opponent instead."
    }
  ]
}
