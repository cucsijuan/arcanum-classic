  "spell": {
    "targets": [
      "creature"
    ],
    "effects": [
      {
        "if": {
          "target": "target",
          "is": {
            "keyword": "Flying"
          }
        },
        "then": [
          {
            "damage": {
              "power": "target",
              "times": 2
            },
            "to": "target",
            "from": "target"
          }
        ],
        "else": [
          {
            "damage": {
