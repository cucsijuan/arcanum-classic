        "types": [
          "creature"
        ],
        "supertype": "legendary",
        "minManaValue": 4
      }
    },
    {
      "trigger": "endStep",
      "effects": [
        {
          "tokens": 2,
          "token": {
            "name": "Human Soldier",
            "types": "Creature — Human Soldier",
            "colors": [
              "W"
            ],
            "power": 1,
            "toughness": 1
          }
        }
      ],
      "text": "At the beginning of your end step, if you're the monarch, create two 1/1 white Human Soldier creature tokens.",
