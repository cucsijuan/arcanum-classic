{
  "name": "Sonar Strike",
  "spell": {
    "targets": [
      {
        "kind": "creature",
        "controller": "any",
        "filter": {
          "anyOf": [
            {
              "attacking": true
            },
            {
              "blocking": true
            },
            {
              "tapped": true
            }
          ]
        },
        "text": "target attacking, blocking, or tapped creature"
      }
    ],
    "effects": [
      {
        "damage": 4,
        "to": "target"
      },
      {
        "if": {
          "control": {
            "subtype": "Bat"
          }
        },
        "then": [
          {
            "gainLife": 3
          }
        ]
      }
    ],
    "text": "Sonar Strike deals 4 damage to target attacking, blocking, or tapped creature. You gain 3 life if you control a Bat."
  }
}
