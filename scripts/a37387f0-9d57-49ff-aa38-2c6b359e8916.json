{
  "name": "Grab the Prize",
  "additionalCost": {
    "discard": 1
  },
  "spell": {
    "effects": [
      {
        "draw": 2
      },
      {
        "if": {
          "atLeast": {
            "discarded": {
              "not": [
                "land"
              ]
            }
          },
          "value": 1
        },
        "then": [
          {
            "damage": 2,
            "to": "opponents"
          }
        ]
      }
    ],
    "text": "Draw two cards. If the discarded card wasn't a land card, Grab the Prize deals 2 damage to each opponent."
  }
}
