{
  "name": "Finneas, Ace Archer",
  "abilities": [
    {
      "trigger": "attacks",
      "effects": [
        {
          "counters": 1,
          "what": {
            "each": {
              "types": [
                "creature"
              ],
              "controller": "you",
              "other": true,
              "anyOf": [
                {
                  "token": true
                },
                {
                  "subtype": "Rabbit"
                }
              ]
            }
          }
        },
        {
          "if": {
            "totalPower": 10
          },
          "then": [
            {
              "draw": 1
            }
          ]
        }
      ],
      "text": "Whenever Finneas attacks, put a +1/+1 counter on each other creature you control that's a token or a Rabbit. Then if creatures you control have total power 10 or greater, draw a card."
    }
  ]
}
