{
  "userAgent": "Arcanum/0.1 (open-source card game client)",
  "cards": {
    "format": "oracle-jsonl",
    "index": "https://api.scryfall.com/bulk-data/oracle-cards",
    "downloadField": "jsonl_download_uri",
    "updatedField": "updated_at",
    "includeIfLegalIn": [
      "vintage",
      "legacy",
      "commander",
      "pauper",
      "oathbreaker",
      "premodern",
      "oldschool",
      "predh"
    ],
    "excludeLayouts": [
      "art_series",
      "planar",
      "scheme",
      "vanguard",
      "emblem",
      "front_card",
      "augment",
      "host",
      "double_faced_token"
    ]
  },
  "printings": {
    "index": "https://api.scryfall.com/bulk-data/default-cards",
    "downloadField": "jsonl_download_uri"
  },
  "images": {
    "urlTemplate": "https://api.scryfall.com/cards/named?format=image&version=large&exact={name}",
    "minIntervalMs": 120,
    "byIdTemplate": "https://api.scryfall.com/cards/{id}?format=image&version=large",
    "backUrlTemplate": "https://api.scryfall.com/cards/named?format=image&version=large&face=back&exact={name}",
    "backByIdTemplate": "https://api.scryfall.com/cards/{id}?format=image&version=large&face=back"
  },
  "commanderInsights": {
    "pageTemplate": "https://json.edhrec.com/pages/commanders/{slug}.json",
    "averageDeckTemplate": "https://json.edhrec.com/pages/average-decks/{slug}.json",
    "cacheDays": 7
  },
  "deckSearch": {
    "searchTemplate": "https://archidekt.com/api/decks/v3/?deckFormat={format}&cardName={card}&size=90&sizeLogic=LTE&orderBy=-viewCount",
    "popularTemplate": "https://archidekt.com/api/decks/v3/?deckFormat={format}&size=90&sizeLogic=LTE&orderBy=-viewCount",
    "deckTemplate": "https://archidekt.com/api/decks/{id}/",
    "formats": { "casual": "", "standard": "1", "pioneer": "15", "modern": "2", "legacy": "4", "vintage": "5", "pauper": "6" },
    "cacheDays": 7,
    "minIntervalMs": 300
  },
  "cardBacks": [
    {
      "id": "classic",
      "name": "Classic",
      "url": "https://backs.scryfall.io/large/0/a/0aeebaf5-8c7d-4636-9e82-8c27447861f7.jpg"
    }
  ]
}
